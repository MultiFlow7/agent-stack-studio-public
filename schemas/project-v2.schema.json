{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentstack.studio/schemas/project-v2.json",
  "title": "Agent Stack Studio Project v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "name",
    "description",
    "revision",
    "components",
    "stack",
    "workflows",
    "versions",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "$schema": { "const": "https://agentstack.studio/schemas/project-v2.json" },
    "formatVersion": { "const": 2 },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "revision": { "type": "integer", "minimum": 0 },
    "profile": { "$ref": "#/$defs/agentProfile" },
    "modelConfiguration": {
      "oneOf": [{ "$ref": "#/$defs/modelConfiguration" }, { "type": "null" }]
    },
    "components": {
      "type": "array",
      "items": { "$ref": "project-v1.schema.json#/$defs/component" }
    },
    "stack": { "$ref": "project-v1.schema.json#/$defs/stack" },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } },
    "versions": { "type": "array", "items": { "$ref": "#/$defs/projectVersion" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "modelConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modelId", "credentialRequirement"],
      "properties": {
        "providerId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "credentialRequirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "credentialKind"],
          "properties": {
            "method": { "enum": ["api-key", "official-login", "existing-login"] },
            "credentialKind": { "enum": ["api-key", "harness-session"] }
          }
        }
      }
    },
    "agentSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "markdown", "enabled"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "markdown": { "type": "string", "maxLength": 40000 },
        "enabled": { "type": "boolean" }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "transport",
        "command",
        "args",
        "url",
        "secretReferences",
        "enabled",
        "approval"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "transport": { "enum": ["stdio", "http"] },
        "command": { "type": ["string", "null"], "maxLength": 1000 },
        "args": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "maxLength": 1000 }
        },
        "url": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 },
        "secretReferences": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" }
        },
        "enabled": { "type": "boolean" },
        "approval": { "enum": ["review-required", "approved"] }
      }
    },
    "agentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "memoryMarkdown", "skills", "mcpServers", "toolPolicy"],
      "properties": {
        "instructions": { "type": "string", "maxLength": 40000 },
        "memoryMarkdown": { "type": "string", "maxLength": 120000 },
        "skills": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/agentSkill" }
        },
        "mcpServers": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/mcpServer" }
        },
        "toolPolicy": { "enum": ["read-only", "workspace"] }
      }
    },
    "workflowNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "operation"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "kind": { "const": "operation" },
            "operation": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "componentId"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "kind": { "const": "component" },
            "componentId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "agentVersionId"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "kind": { "const": "agent-version" },
            "agentVersionId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "workflowId", "workflowVersionId"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "kind": { "const": "workflow-version" },
            "workflowId": { "type": "string", "format": "uuid" },
            "workflowVersionId": { "type": "string", "format": "uuid" }
          }
        }
      ]
    },
    "workflowEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "from": { "type": "string", "format": "uuid" },
        "to": { "type": "string", "format": "uuid" }
      }
    },
    "workflowVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versionNumber", "sourceRevision", "contentHash", "snapshot", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "versionNumber": { "type": "integer", "minimum": 1 },
        "sourceRevision": { "type": "integer", "minimum": 0 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description", "nodes", "edges"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "description": { "type": "string", "maxLength": 500 },
            "nodes": { "type": "array", "items": { "$ref": "#/$defs/workflowNode" } },
            "edges": { "type": "array", "items": { "$ref": "#/$defs/workflowEdge" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "revision",
        "nodes",
        "edges",
        "versions",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "revision": { "type": "integer", "minimum": 0 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/workflowNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/workflowEdge" } },
        "versions": { "type": "array", "items": { "$ref": "#/$defs/workflowVersion" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "projectVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versionNumber", "sourceRevision", "contentHash", "snapshot", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "versionNumber": { "type": "integer", "minimum": 1 },
        "sourceRevision": { "type": "integer", "minimum": 0 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "stack", "components"],
          "properties": {
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            },
            "profile": { "$ref": "#/$defs/agentProfile" },
            "modelConfiguration": { "$ref": "#/$defs/modelConfiguration" },
            "stack": { "$ref": "project-v1.schema.json#/$defs/stack" },
            "components": {
              "type": "array",
              "items": { "$ref": "project-v1.schema.json#/$defs/component" }
            },
            "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
